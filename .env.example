# =====================================================================
# Supabase Configuration (Modern API Key Format)
# =====================================================================

# SUPABASE_URL: Project API URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Client-safe public key used by frontend / browser with Row Level Security (RLS)
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Client-side Vite environment variable (mirrors publishable key to the browser)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# SUPABASE_SECRET_KEY: Privileged backend secret key.
# CRITICAL: NEVER expose this key through frontend code, client bundles, or any VITE_ variable!
SUPABASE_SECRET_KEY="your-secret-key"

# =====================================================================
# Google Gemini AI Configuration
# =====================================================================

# GEMINI_API_KEY: Server-side API key for generative AI, RAG grounded chat, and ticket intelligence
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Recommended alias for conversational reasoning and grounding
GEMINI_MODEL="gemini-3.8-flash"

# =====================================================================
# Operational Host & Network (Optional in Preview/Dev)
# =====================================================================
PORT="3000"
APP_URL="MY_APP_URL"
# CLIENT_URL is optional during local development and preview environments
CLIENT_URL=""
